# Application Environment
NODE_ENV=production
PORT=5001
VITE_API_URL=/api

# Database Configuration (PostgreSQL in production, SQLite for local dev)
# DATABASE_URL="postgresql://user:password@localhost:5432/alphalinkx_db?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secret for Protected Admin Area
JWT_SECRET=your_jwt_secret_change_in_production

# Admin Default Credentials
ADMIN_EMAIL=admin@alphalinkx.com
ADMIN_PASSWORD=change_this_password

# Email Service Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
AGENCY_NOTIFICATION_EMAIL=leads@alphalinkx.com
